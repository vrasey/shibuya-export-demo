/* =========================================
   Mobile Responsiveness
   ========================================= */
@media (max-width: 768px) {
    .nav-wrap {
        position: relative;
        flex-direction: column;
        align-items: flex-start;
        height: auto;
        padding: 12px 16px;
        gap: 10px;
    }

    .brand {
        font-size: 1rem;
        padding-right: 44px; /* Leaves room for the top-right theme button */
    }

    .brand-logo {
        height: 38px;
        width: 38px;
    }

    nav {
        width: 100%;
        padding-top: 10px;
        border-top: 1px solid var(--border-color);
    }

    nav ul {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 4px;
    }

    nav a {
        font-size: 0.85rem;
        padding: 6px 6px;
        white-space: nowrap;
    }

    .btn-nav {
        padding: 6px 12px !important;
        font-size: 0.85rem !important;
    }

    /* Pin the dark-mode button to the top-right corner on mobile */
    .theme-btn {
        position: absolute;
        top: 15px;
        right: 16px;
        padding: 5px 8px;
        font-size: 1rem;
    }

    .hero {
        padding: 48px 0 96px;
    }

    .hero h1 {
        font-size: 2rem;
        margin-bottom: 12px;
    }

    .hero p {
        font-size: 1rem;
        margin-bottom: 24px;
    }

    .hero-actions {
        flex-direction: column;
        width: 100%;
        padding: 0 16px;
        gap: 12px;
    }

    .btn {
        width: 100%;
    }

    .hero .social-links {
        margin-top: 24px;
        margin-bottom: 10px;
    }

    .scroll-arrow {
        bottom: 18px;
    }

    .grid-2,
    .grid-3,
    .contact-grid,
    .form-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .form-group.full {
        grid-column: span 1;
    }

    .section {
        padding: 48px 0;
    }

    .card {
        padding: 22px;
    }

    .data-table th,
    .data-table td {
        padding: 10px 8px;
        font-size: 0.88rem;
    }

    .tab-nav {
        flex-direction: column;
        padding: 0 16px;
    }

    .tab-btn {
        width: 100%;
    }
}