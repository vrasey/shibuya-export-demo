:root {
  --bg-main: #f5f5f5;         /* Pure light neutral grey background */
  --bg-card: #ffffff;         /* Pure white cards */
  --border-color: #e5e5e5;    /* Neutral grey borders */
  --border-hover: #d4d4d4;
  --text-primary: #171717;
  --text-secondary: #525252;  /* Medium neutral grey */
  --btn-primary: #404040;     /* Neutral dark grey button */
  --btn-primary-hover: #171717; 
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --max-w: 1140px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
  transition: opacity 0.2s, color 0.2s;
}

a:hover {
  opacity: 0.8;
}

.container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
}

/* Header & Nav */
header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
}

.nav-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 76px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-primary);
}

.brand-logo {
  height: 42px;
  width: auto;
  border-radius: 50%;
}

nav ul {
  display: flex;
  list-style: none;
  gap: 28px;
  align-items: center;
}

nav a {
  font-size: 0.95rem;
  color: var(--text-secondary);
  font-weight: 600;
}

nav a.active, nav a:hover {
  color: var(--text-primary);
}

.btn-nav {
  padding: 8px 18px;
  background: var(--btn-primary);
  color: #ffffff !important;
  border-radius: 6px;
}

.btn-nav:hover {
  background: var(--btn-primary-hover);
}

/* Hero Section */
.hero {
  position: relative; /* Required to anchor the bouncing arrow */
  padding: 120px 0 100px;
  text-align: center;
  /* Dark overlay + the background image */
  background: linear-gradient(rgba(23, 23, 23, 0.75), rgba(23, 23, 23, 0.85)), url('shibuya.jpeg') center/cover no-repeat;
  color: #ffffff;
}

.hero .badge {
  display: inline-block;
  padding: 6px 16px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 24px;
}

.hero h1 {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 20px;
  color: #ffffff;
}

.hero p {
  font-size: 1.15rem;
  color: #e5e5e5;
  max-width: 680px;
  margin: 0 auto 36px;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 16px;
}

/* Bouncing Arrow */
.scroll-arrow {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  color: #ffffff;
  animation: bounce 2s infinite;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.2s;
}

.scroll-arrow:hover {
  opacity: 0.7;
}

.scroll-arrow svg {
  width: 32px;
  height: 32px;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translate(-50%, 0); }
  40% { transform: translate(-50%, -10px); }
  60% { transform: translate(-50%, -5px); }
}

.btn {
  padding: 14px 32px;
  border-radius: 6px;
  font-weight: 600;
  font-size: 1rem;
  display: inline-block;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--btn-primary);
  color: #ffffff;
}

.btn-primary:hover {
  background: var(--btn-primary-hover);
  transform: translateY(-1px);
}

.btn-secondary {
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  background: #ffffff;
}

.btn-secondary:hover {
  border-color: var(--text-secondary);
  background: #f5f5f5;
}

/* Feature / Card Grids */
.section {
  padding: 70px 0;
}

.section-head {
  text-align: center;
  margin-bottom: 50px;
}

.section-head h2 {
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 12px;
  color: var(--text-primary);
}

.section-head p {
  color: var(--text-secondary);
  font-size: 1.1rem;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 32px;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 40px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
}

.card h3 {
  font-size: 1.25rem;
  margin-bottom: 12px;
  color: var(--text-primary);
}

.card p {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* Past Work & Dealer Cards */
.work-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.work-img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  background: #f5f5f5;
  border-bottom: 1px solid var(--border-color);
}

.work-content {
  padding: 24px;
}

.work-tag {
  font-size: 0.75rem;
  text-transform: uppercase;
  color: var(--text-secondary);
  font-weight: 700;
  letter-spacing: 0.08em;
}

/* Sourcing Tabs */
.tab-nav {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-bottom: 40px;
}

.tab-btn {
  padding: 12px 24px;
  border: 1px solid var(--border-color);
  background: #ffffff;
  color: var(--text-secondary);
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.2s;
}

.tab-btn:hover {
  background: #f5f5f5;
  color: var(--text-primary);
}

.tab-btn.active {
  background: var(--text-primary);
  color: #ffffff;
  border-color: var(--text-primary);
}

.tab-content {
  display: none;
  animation: fadeIn 0.3s ease-in-out;
}

.tab-content.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Forms & Inputs */
.contact-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 48px;
  align-items: start;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.form-group.full {
  grid-column: span 2;
}

.form-group label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  font-weight: 600;
}

input, select, textarea {
  width: 100%;
  padding: 14px 16px;
  background: #f5f5f5;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--text-secondary);
  background: #ffffff;
}

/* Footer */
footer {
  border-top: 1px solid var(--border-color);
  padding: 40px 0;
  margin-top: 80px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-align: center;
  background: #ffffff;
}