            <!-- Fix 10 Office Details -->
            <div class="card" style="background: var(--bg-main); border: none;">
                <h3 style="margin-bottom: 24px;">Office Details</h3>
                
                <div style="margin-bottom: 20px;">
                    <p style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">WhatsApp / Phone</p>
                    <p style="font-size: 1.05rem; color: var(--text-primary); font-weight: 500;"><a href="https://wa.me/817085243763" target="_blank">+81 70 8524 3763</a> (fastest reply[cite: 48])</p>
