                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top: 10px;">Send Message</button>
                    <a href="https://wa.me/817085243763" target="_blank" class="btn btn-secondary" style="width:100%; margin-top: 10px; text-align: center; display: block;">Message Us on WhatsApp</a>
