                <div style="margin-bottom: 20px;">
                    <p style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Email</p>
                    <p style="font-size: 1.05rem; color: var(--text-primary); font-weight: 500;">sales@shibuyaexport.com[cite: 48]</p>
                </div>
                <div style="margin-bottom: 20px;">
                    <p style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Instagram</p>
                    <p style="font-size: 1.05rem; color: var(--text-primary); font-weight: 500;">@shibuyaexport[cite: 48]</p>
                </div>
                <div style="margin-bottom: 20px;">
