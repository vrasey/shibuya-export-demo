<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Past Exports | Shibuya Export</title>
    <link rel="stylesheet" href="style.css">
    <style>
        /* Thumbnail gallery strip for multi-photo export cards */
        .thumb-strip {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            padding: 8px 12px;
            background-color: var(--bg-input);
            border-bottom: 1px solid var(--border-color);
        }
        .thumb-strip img {
            width: 100%;
            height: 56px;
            object-fit: cover;
            border-radius: 4px;
            cursor: pointer;
            opacity: 0.55;
            transition: opacity 0.2s, border-color 0.2s;
            border: 2px solid transparent;
        }
        .thumb-strip img:hover,
        .thumb-strip img.active-thumb {
            opacity: 1;
            border-color: var(--text-primary);
        }
    </style>
</head>
<body>

<header>
    <div class="container nav-wrap">
        <a href="index.html" class="brand">
            <img src="logo.png" alt="Shibuya Export Logo" class="brand-logo">
            Shibuya Export
        </a>
        <nav>
            <ul>
                <li><a href="index.html">Overview</a></li>
                <li><a href="sourcing.html">Sourcing</a></li>
                <li><a href="past-work.html" class="active">Past Exports</a></li>
                <li><a href="contact.html" class="btn-nav">Contact</a></li>
                <li>
                    <button id="theme-toggle" class="theme-btn" aria-label="Toggle Dark Mode">🌗</button>
                </li>
            </ul>
        </nav>
    </div>
</header>

<section class="section">
    <div class="container">
        <!-- Fix 9: Header & Copy -->
        <div class="section-head">
            <h2>Previously Exported Vehicles</h2>
            <p>A selection of cars we've sourced, inspected and shipped to clients around the world.</p>
        </div>

        <div class="grid-3">
            <!-- Tester Car: Porsche Cayenne GTS -->
            <div class="work-card">
                <img id="cayenne-main-img" src="porsche_suv_3.jpeg" alt="Porsche Cayenne GTS" class="work-img" style="height: 250px;">
                
                <!-- 3-Photo Switcher -->
                <div class="thumb-strip">
                    <img src="porsche_suv_3.jpeg" alt="Front Quarter" class="active-thumb" onclick="swapPhoto('cayenne-main-img', this)">
                    <img src="porsche_suv_1.jpeg" alt="Rear Quarter" onclick="swapPhoto('cayenne-main-img', this)">
                    <img src="porsche_suv_2.jpeg" alt="Interior RHD" onclick="swapPhoto('cayenne-main-img', this)">
                </div>

                <div class="work-content">
                    <span class="work-tag">Exported • Container • RHD</span>
                    <h3>Porsche Cayenne GTS</h3>
                    <p class="work-price">¥17,000,000</p>
                    <p class="work-desc" style="margin-bottom: 0;">Dealer sourced, inspected, de-registered and shipped to destination port.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Fix 12: Footer -->
<footer>
    <div class="container">
